{
  "manifest_version": 3,
  "name": "Playtoon Question Reader",
  "version": "0.1.0",
  "description": "Sends questions visible on pages you enable (text and chatbot messages) to your Playtoon engine.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Playtoon" }
}
